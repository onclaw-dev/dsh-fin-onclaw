{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "contract", "providerInjection", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "commit", "betterSidebar", "schemastery", "react"],
      "properties": {
        "tag": { "const": "dsh-v0.1.1-rc.2" },
        "version": { "const": "0.1.1-rc.2" },
        "commit": { "const": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e" },
        "betterSidebar": { "const": "0.17.1" },
        "schemastery": { "const": "3.18.1" },
        "react": { "const": "18.3.1" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "hostHif", "clientHifs"],
      "properties": {
        "base": { "const": "ONCLAW-BASE-1" },
        "hostHif": { "const": "ONCLAW-HOST-HIF-1" },
        "clientHifs": {
          "type": "array",
          "const": ["ONCLAW-HIF-1", "ONCLAW-HIF-2"]
        }
      }
    },
    "providerInjection": {
      "type": "array",
      "const": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "dsh-better-sidebar"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/tag" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "not-run"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "sidebar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "relationship", "reason"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "relationship": { "enum": ["formal", "candidate", "no-match"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag", "version", "commit", "contract", "hostHif", "clientHif",
        "schemastery", "providers", "missingPackages", "betterSidebar",
        "audited", "registry", "packageVerification", "liveSmoke"
      ],
      "properties": {
        "tag": { "type": "string", "pattern": "^dsh-v" },
        "version": { "type": "string", "pattern": "^[0-9]" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": { "const": "ONCLAW-BASE-1" },
        "hostHif": { "const": "ONCLAW-HOST-HIF-1" },
        "clientHif": { "enum": ["ONCLAW-HIF-1", "ONCLAW-HIF-2"] },
        "schemastery": { "enum": ["3.18.1", "3.18.2"] },
        "providers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "missingPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "betterSidebar": { "$ref": "#/$defs/sidebar" },
        "audited": { "$ref": "#/$defs/result" },
        "registry": { "$ref": "#/$defs/result" },
        "packageVerification": { "$ref": "#/$defs/result" },
        "liveSmoke": { "$ref": "#/$defs/result" }
      }
    }
  }
}
